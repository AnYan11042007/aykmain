{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN')"
    },
    "auth_mapping": {
      ".read": true,
      "$authUid": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $authUid || auth.token.admin === true || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "wallets": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('auth_mapping').child(auth.uid).val() === $uid || auth.token.admin === true || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $uid || root.child('auth_mapping').child(auth.uid).val() === $uid || auth.token.admin === true || root.child('admins').child(auth.uid).val() === true)",
        "pass": {
          ".validate": false
        },
        "pp": {
          ".validate": "auth != null && (auth.token.admin === true || root.child('admins').child(auth.uid).val() === true || auth.token.role === 'ADMIN' || auth.uid === $uid || root.child('auth_mapping').child(auth.uid).val() === $uid)"
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || root.child('admins').child(auth.uid).val() === true)"
    },
    "matches": {
      ".read": true,
      ".write": "auth != null"
    },
    "quests": {
      ".read": true,
      "$uid": {
        ".write": "auth != null"
      }
    },
    "daily_missions_pool": {
      ".read": true,
