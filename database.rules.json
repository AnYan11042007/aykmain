{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN')"
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true || auth.token.role === 'ADMIN' || root.child('admins').child(auth.uid).val() === true)",
        
        "pp": {
          ".validate": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN' || root.child('admins').child(auth.uid).val() === true)"
        },
        "role": {
          ".validate": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN' || root.child('admins').child(auth.uid).val() === true)"
        },
        "xp": {
          ".validate": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN' || root.child('admins').child(auth.uid).val() === true)"
        },
        "locked": {
          ".validate": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN' || root.child('admins').child(auth.uid).val() === true)"
        },
        "pass": {
          ".validate": false
        }
      }
    },

    "market": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN' || root.child('admins').child(auth.uid).val() === true)"
    },

    "online": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "online_logs": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true || auth.token.role === 'ADMIN')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "global_chat": {
      ".read": "auth != null",
      "$msgId": {
        ".write": "auth != null && (!data.exists() || auth.token.admin === true || auth.token.role === 'ADMIN')",
        ".validate": "newData.hasChildren(['senderId', 'message']) && newData.child('senderId').val() === auth.uid && newData.child('message').isString() && newData.child('message').val().length <= 500"
      }
    },

    "game_logs": {
      ".read": "auth != null",
      "$logId": {
        ".write": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN' || root.child('admins').child(auth.uid).val() === true || (newData.child('uid').val() === auth.uid))"
      }
    },

    "registration_logs": {
      ".read": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN')",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "password_reset_requests": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true || auth.token.role === 'ADMIN')"
      }
    },

    "rankings": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN')"
    },

    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN')"
    },

    "poker_rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (auth.token.admin === true || auth.token.role === 'ADMIN' || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "poker_private": {
      "$roomId": {
        "deck": {
          ".read": false,
          ".write": false
        },
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true || auth.token.role === 'ADMIN')",
          ".write": false
        }
      }
    }
  }
}
